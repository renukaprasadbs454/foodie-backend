# Copy to .env for local overrides (never commit real secrets)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=foodie
DB_USER=foodie
DB_PASSWORD=foodie

REDIS_HOST=localhost
REDIS_PORT=6379

# Auth (Module 1)
JWT_SECRET=local-dev-only-change-me-foodie-jwt-secret-key-32b
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# WhatsApp Cloud API & OTP Verification
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_API_VERSION=v18.0
WHATSAPP_OTP_TEMPLATE_NAME=foodie_otp_verify
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Object storage (local adapter for Module 2+; S3/R2 later)
FOODIE_LOCAL_STORAGE_ROOT=./.local-object-storage

# Restaurant (Module 3) — client-supplied commissionPct is ignored
FOODIE_DEFAULT_COMMISSION_PCT=18.00

# Razorpay (Module 7) — never commit live secrets
RAZORPAY_MODE=stub
RAZORPAY_KEY_ID=rzp_test_local
RAZORPAY_KEY_SECRET=local-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=local-razorpay-webhook-secret
# RAZORPAY_MODE=live
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# FCM (Module 10) — never commit live credentials
FCM_MODE=stub
# FCM_MODE=live
# FCM_PROJECT_ID=
# FCM_CREDENTIALS_PATH=
# FCM_MAX_ATTEMPTS=3
# AWS_S3_BUCKET=

# Maps / Location API
MAPS_PROVIDER=google
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
